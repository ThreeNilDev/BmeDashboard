@page
@model IndexModel
@{
    ViewData["Title"] = "BME680 Dashboard";
}

<h1>BME680 Dashboard</h1>


@if (Model.ErrorMessage is not null)
{
    <p class="text-danger">@Model.ErrorMessage</p>
}
else
{
   <div class="container">
    <div class="row g-4">

        <div class="col-lg-4 col-md-6 col-12">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="card-title">Sensor Readings (Page refresh)</h2>
                    <ul class="reading-list">
                        <li><span class="lookup-label" data-term="Temperature">Temperature: </span><span>@(Model.TemperatureC?.ToString("F1") ?? "N/A") °C</span></li>
                        <li><span class="lookup-label" data-term="Pressure">Pressure: </span><span>@(Model.PressureHpa?.ToString("F1") ?? "N/A") hPa</span></li>
                        <li><span class="lookup-label" data-term="Humidity">Humidity: </span><span>@(Model.HumidityPercent?.ToString("F1") ?? "N/A") %</span></li>
                        <li><span class="lookup-label" data-term="Dew Point">Dew Point: </span><span>@(Model.DewpointC?.ToString("F1") ?? "N/A") °C</span></li>
                        <li><span class="lookup-label" data-term="Heat Index">Heat Index: </span><span>@(Model.HeatIndexC?.ToString("F1") ?? "N/A") °C</span></li>
                        <li><span class="lookup-label" data-term="Altitude">Altitude: </span><span>@(Model.AltitudeMeters?.ToString("F1") ?? "N/A") m</span></li>
                    </ul>
                    <p><small>Last updated: @DateTime.Now.ToString("HH:mm:ss")</small></p>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="card-title">Sensor Readings (Close to Real-time)</h2>
<ul class="reading-list">
    <li>Temperature: <span><span id="temperature">@(Model.TemperatureC?.ToString("F1") ?? "N/A")</span> °C</span></li>
    <li>Pressure: <span><span id="pressure">@(Model.PressureHpa?.ToString("F1") ?? "N/A")</span> hPa</span></li>
    <li>Humidity: <span><span id="humidity">@(Model.HumidityPercent?.ToString("F1") ?? "N/A")</span> %</span></li>
</ul>
                    <p><small>Last updated: <span id="last-updated">@DateTime.Now.ToString("HH:mm:ss")</span></small></p>
                    <div class="mb-2">
                        <label for="refresh-interval" class="form-label">Refresh every:</label>
                        <select id="refresh-interval" class="form-select">
                            <option value="5000">5 seconds</option>
                            <option value="10000" selected>10 seconds</option>
                            <option value="30000">30 seconds</option>
                            <option value="60000">1 minute</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="card-title">Local Weather</h2>
                    <ul class="reading-list">
                        <li>Outdoor Temperature: <span>@(Model.OutdoorTemperatureC?.ToString("F1") ?? "N/A") °C</span></li>
                        <li>Pressure: <span>@(Model.OutdoorPressureHpa?.ToString("F1") ?? "N/A") hPa</span></li>
                        <li>Humidity: <span>@(Model.OutdoorHumidity?.ToString("F1") ?? "N/A") %</span></li>
                        <li>Conditions: <span>@Model.WeatherDescription</span></li>
                        
                    </ul>
                    <p><small>Last updated: @Model.WeatherTimestamp?.ToString("HH:mm:ss")</small></p>
                </div>
            </div>
        </div>

    </div>
</div>
}


