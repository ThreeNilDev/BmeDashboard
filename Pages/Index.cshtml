@section Scripts {
    <script>
        let refreshTimer;

        function fetchLatestReading() {
            fetch('/Index?handler=LatestReading')
                .then(response => response.json())
                .then(data => {
                    document.getElementById('temperature').textContent = data.temperature?.toFixed(1) ?? 'N/A';
                    document.getElementById('pressure').textContent = data.pressure?.toFixed(1) ?? 'N/A';
                    document.getElementById('humidity').textContent = data.humidity?.toFixed(1) ?? 'N/A';
                    document.getElementById('last-updated').textContent = data.timestamp;
                })
                .catch(err => console.error('Failed to fetch reading:', err));
        }

        function startPolling(intervalMs) {
            if (refreshTimer) clearInterval(refreshTimer);
            refreshTimer = setInterval(fetchLatestReading, intervalMs);
        }

        document.getElementById('refresh-interval').addEventListener('change', function () {
            startPolling(parseInt(this.value));
        });

        // Start polling immediately with the default selected interval
        startPolling(parseInt(document.getElementById('refresh-interval').value));
    </script>
}