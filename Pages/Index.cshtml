await _dbContext.SaveChangesAsync(); *@


@section Scripts {
    <script>
        let refreshTimer;

        function fetchLatestReading() {
            fetch('/Index?handler=LatestReading')
                .then(response => response.json())
                .then(data => {
                    document.getElementById('temperature').textContent = data.temperature?.toFixed(1) ?? 'N/A';
                    document.getElementById('pressure').textContent = data.pressure?.toFixed(1) ?? 'N/A';
                    document.getElementById('humidity').textContent = data.humidity?.toFixed(1) ?? 'N/A';
                    document.getElementById('last-updated').textContent = data.timestamp;
                })
                .catch(err => console.error('Failed to fetch reading:', err));
        }

        function startPolling(intervalMs) {
            if (refreshTimer) clearInterval(refreshTimer);
            refreshTimer = setInterval(fetchLatestReading, intervalMs);
        }

        document.getElementById('refresh-interval').addEventListener('change', function () {
            startPolling(parseInt(this.value));
        });

        // Start polling immediately with the default selected interval
        startPolling(parseInt(document.getElementById('refresh-interval').value));

        document.addEventListener("DOMContentLoaded", function() {
            const drawer = document.getElementById('searchDrawer');
            const drawerTitle = document.getElementById('drawerTitle');
            const drawerDescription = document.getElementById('drawerDescription');
            const drawerLink = document.getElementById('drawerLink');

            // Click listener for labels
            document.querySelectorAll('.lookup-label').forEach(label => {
                label.addEventListener('click', async function(e) {
                    e.stopPropagation(); // Avoid triggering immediate body closures
                    const term = this.getAttribute('data-term');

                    // Display initial header updates
                    drawerTitle.textContent = term;
                    drawerDescription.textContent = "Loading context info from Wikipedia...";
                    drawerLink.style.display = "none";

                    // Reveal the bottom drawer container
                    drawer.classList.add('open');

                    try {
                        // Request summary definitions asynchronously using standard endpoints
                        const response = await fetch(`https://wikipedia.org{encodeURIComponent(term)}`);
                        if (!response.ok) throw new Error("Data unavailable");

                        const data = await response.json();
                        drawerDescription.textContent = data.extract;
                        drawerLink.href = data.content_urls.desktop.page;
                        drawerLink.style.display = "inline-block";
                    } catch (err) {
                        drawerDescription.textContent = `Could not fetch a live definition for "${term}". Please ensure you are connected to the network.`;
                    }
                });
            });

            // Standard dismiss layer: Close when user clicks anywhere outside the active panel
            document.addEventListener('click', function(e) {
                if (!drawer.contains(e.target)) {
                    drawer.classList.remove('open');
                }
            });
        });
    </script>
}