@page
@model IndexModel
@{
    ViewData["Title"] = "BME680 Dashboard";
}

<h1>Sensor Readings</h1>

@if (Model.ErrorMessage is not null)
{
    <p style="color:red">@Model.ErrorMessage</p>
}
else
{
    <ul>
        <li>Temperature: @(Model.TemperatureC?.ToString("F1") ?? "N/A") °C</li>
        <li>Pressure: @(Model.PressureHpa?.ToString("F1") ?? "N/A") hPa</li>
        <li>Humidity: @(Model.HumidityPercent?.ToString("F1") ?? "N/A") %</li>
        <p><small>Last updated: @DateTime.Now.ToString("HH:mm:ss")</small></p>
    </ul>

    <h1>Sensor Readings</h1>

    <ul>
        <li>Temperature: <span id="temperature">@(Model.TemperatureC?.ToString("F1") ?? "N/A")</span> °C</li>
        <li>Pressure: <span id="pressure">@(Model.PressureHpa?.ToString("F1") ?? "N/A")</span> hPa</li>
        <li>Humidity: <span id="humidity">@(Model.HumidityPercent?.ToString("F1") ?? "N/A")</span> %</li>
    </ul>

    <p><small>Last updated: <span id="last-updated">@DateTime.Now.ToString("HH:mm:ss")</span></small></p>

    <label for="refresh-interval">Refresh every:</label>
    <select id="refresh-interval">
        <option value="5000">5 seconds</option>
        <option value="10000" selected>10 seconds</option>
        <option value="30000">30 seconds</option>
        <option value="60000">1 minute</option>
    </select>


}



