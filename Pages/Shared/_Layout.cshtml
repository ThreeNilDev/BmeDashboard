<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BmeDashboard</title>
    <script type="importmap"></script>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
   
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">BmeDashboard</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
          <li class="nav-item">
    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")"
       asp-area="" asp-page="/Index">Home</a>
</li>
<li class="nav-item">
    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Privacy" ? "active" : "")"
       asp-area="" asp-page="/Privacy">Privacy</a>
</li>
<li class="nav-item">
    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/History" ? "active" : "")"
       asp-area="" asp-page="/History">History</a>
</li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BmeDashboard - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Custom Bottom Look-up Drawer Overlay -->
    <div id="searchDrawer" class="bottom-drawer">
        <div class="drawer-handle"></div>
        <div class="drawer-content">
            <div class="drawer-header-row">
                <span class="g-logo">G</span>
                <h3 id="drawerTitle">Measurement</h3>
            </div>
            <p id="drawerDescription">Loading definition...</p>
            <a id="drawerLink" href="#" target="_blank" class="drawer-btn">Read full article on Wikipedia</a>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
