@page
@model HistoryModel
@{
    ViewData["Title"] = "Sensor History";
}

<h1>Sensor History</h1>

<label for="days-select">Show last:</label>
<select id="days-select">
    <option value="1">24 hours</option>
    <option value="3">3 days</option>
    <option value="7" selected>7 days</option>
    <option value="14">14 days</option>
    <option value="30">30 days</option>
</select>

<label style="margin-left: 15px;">
    <input type="checkbox" id="hourly-toggle" />
    Show hourly averages
</label>

<h2 class="mt-4">Indoor (BME680)</h2>
<canvas id="sensorChart" style="max-width: 100%;"></canvas>

<h2 class="mt-4">Outdoor (Weather)</h2>
<canvas id="weatherChart" style="max-width: 100%;"></canvas>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script>
    let sensorChart;
    let weatherChart;

    function getTimeUnit(days) {
        return days <= 3 ? 'hour' : 'day';
    }

    function buildChartConfig(labels, temps, pressures, humidity, timeUnit) {
        return {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Temperature (°C)', data: temps, borderColor: 'red', yAxisID: 'y' },
                    { label: 'Pressure (hPa)', data: pressures, borderColor: 'blue', yAxisID: 'y1' },
                    { label: 'Humidity (%)', data: humidity, borderColor: 'green', yAxisID: 'y' }
                ]
            },
            options: {
                responsive: true,
                scales: {
                    x: {
                        type: 'time',
                        time: {
                            unit: timeUnit,
                            displayFormats: { hour: 'HH:mm', day: 'dd/MM' }
                        },
                        ticks: {
                            maxRotation: 0,
                            major: { enabled: true },
                            font: (context) => context.tick && context.tick.major
                                ? { size: 12, weight: 'bold' }
                                : { size: 9 }
                        }
                    },
                    y: { type: 'linear', position: 'left' },
                    y1: { type: 'linear', position: 'right', grid: { drawOnChartArea: false } }
                }
            }
        };
    }

    function loadSensorChart(days, hourly) {
        fetch(`/History?handler=ChartData&days=${days}&hourly=${hourly}`)
            .then(response => response.json())
            .then(data => {
                const labels = data.map(d => new Date(d.timestamp));
                const temps = data.map(d => d.temperature);
                const pressures = data.map(d => d.pressure);
                const humidity = data.map(d => d.humidity);
                const timeUnit = getTimeUnit(days);

                if (sensorChart) {
                    sensorChart.data.labels = labels;
                    sensorChart.data.datasets[0].data = temps;
                    sensorChart.data.datasets[1].data = pressures;
                    sensorChart.data.datasets[2].data = humidity;
                    sensorChart.options.scales.x.time.unit = timeUnit;
                    sensorChart.update();
                } else {
                    const ctx = document.getElementById('sensorChart').getContext('2d');
                    const existing = Chart.getChart(ctx);
                    if (existing) existing.destroy();
                    sensorChart = new Chart(ctx, buildChartConfig(labels, temps, pressures, humidity, timeUnit));
                }
            })
            .catch(err => console.error('Failed to load sensor chart data:', err));
    }

    function loadWeatherChart(days, hourly) {
        fetch(`/History?handler=WeatherChartData&days=${days}&hourly=${hourly}`)
            .then(response => response.json())
            .then(data => {
                const labels = data.map(d => new Date(d.timestamp));
                const temps = data.map(d => d.temperature);
                const pressures = data.map(d => d.pressure);
                const humidity = data.map(d => d.humidity);
                const timeUnit = getTimeUnit(days);

                if (weatherChart) {
                    weatherChart.data.labels = labels;
                    weatherChart.data.datasets[0].data = temps;
                    weatherChart.data.datasets[1].data = pressures;
                    weatherChart.data.datasets[2].data = humidity;
                    weatherChart.options.scales.x.time.unit = timeUnit;
                    weatherChart.update();
                } else {
                    const ctx = document.getElementById('weatherChart').getContext('2d');
                    const existing = Chart.getChart(ctx);
                    if (existing) existing.destroy();
                    weatherChart = new Chart(ctx, buildChartConfig(labels, temps, pressures, humidity, timeUnit));
                }
            })
            .catch(err => console.error('Failed to load weather chart data:', err));
    }

    function currentSettings() {
        const days = parseInt(document.getElementById('days-select').value);
        const hourly = document.getElementById('hourly-toggle').checked;
        return { days, hourly };
    }

    function loadAllCharts() {
        const { days, hourly } = currentSettings();
        loadSensorChart(days, hourly);
        loadWeatherChart(days, hourly);
    }

    document.getElementById('days-select').addEventListener('change', loadAllCharts);
    document.getElementById('hourly-toggle').addEventListener('change', loadAllCharts);

    loadAllCharts();
</script>
}